/**
 * @file nxtSegway.oil
 *
 * @section desc File description
 *
 * @section copyright Copyright
 *
 * @section infos File informations
 *
 */
OIL_VERSION = "2.5" : "test" ;

IMPLEMENTATION trampoline {
    TASK {
        UINT32 STACKSIZE = 500 ;
        UINT32 PRIORITY = 1 ;
    } ;
    ISR {
        UINT32 STACKSIZE = 500 ;
    } ;
};

CPU test {

    OS config {
        STATUS = EXTENDED;
        ERRORHOOK = FALSE;
        PRETASKHOOK = FALSE;
        BUILD = TRUE {
            APP_SRC = "nxtSegway.c"; 
            APP_SRC = "tools.c"; 
            APP_NAME = "nxtSegway_exe";
            TRAMPOLINE_BASE_PATH = "/mnt/n7fs/nxt/trampoline/";
            CFLAGS = "-g -c -ffreestanding -fsigned-char -mcpu=arm7tdmi -Os -Winline -Wall -Werror-implicit-function-declaration --param max-inline-insns-single=1000 -ffunction-sections -fdata-sections -std=gnu99";
            CFLAGS = "-I/mnt/n7fs/nxt/trampoline//machines/arm/nxt/drivers/lejos_nxj/src/nxtvm/platform/nxt -I/mnt/n7fs/nxt/trampoline//machines/arm/nxt/drivers/ecrobot/c  -I/mnt/n7fs/nxt/trampoline//machines/arm/nxt/drivers -I/mnt/n7fs/nxt/trampoline//machines/arm/nxt/drivers/ecrobot/bios -I/mnt/n7fs/nxt/trampoline//machines/arm/nxt/drivers/lejos_nxj/src/nxtvm/javavm -I/mnt/n7fs/nxt/trampoline//os -DTRUE=1 -DFALSE=0 -Du8=uint8 -Du32=uint32 -Du16=uint16";
            ASFLAGS = "-g -mcpu=arm7tdmi --fatal-warnings ";
            LDFLAGS = "-g --cref --allow-multiple-definition --gc-sections";
            LDFLAGS = "-L/mnt/n7fs/nxt/gcc-arm-none-eabi-10.3-2021.10//lib/gcc/arm-none-eabi/10.3.1/ -lgcc -L/mnt/n7fs/nxt/gcc-arm-none-eabi-10.3-2021.10//arm-none-eabi/lib -lc";
            COMPILER = "arm-none-eabi-gcc";
            ASSEMBLER = "arm-none-eabi-as";
            LINKER = "arm-none-eabi-ld";
        };
        SYSTEM_CALL = TRUE;
        MEMMAP = TRUE{
          COMPILER = gcc;
          LINKER = gnu_ld { SCRIPT = "script.ld"; };
          ASSEMBLER = gnu_as;
          MEMORY_PROTECTION = FALSE;
        };
    } ;

    APPMODE std {
    };

    TASK pendule {
        AUTOSTART = TRUE {APPMODE = std ;};
        PRIORITY = 3;
        ACTIVATION = 1;
        SCHEDULE = FULL;

    };  

    TASK affichage {
        AUTOSTART = TRUE {APPMODE =std ;};
        PRIORITY = 1;
        ACTIVATION = 1;
        SCHEDULE = FULL;

    };

    TASK obstacle {
        AUTOSTART = TRUE {APPMODE =std ;};
        PRIORITY = 2;
        ACTIVATION = 1;
        SCHEDULE = FULL;
    };
    
    COUNTER SystemCounter {
      SOURCE = it_timer1;
      MAXALLOWEDVALUE = 2000;
      TICKSPERBASE = 1;
      MINCYCLE = 1; 
    };

    ALARM pendule_alarm {
        COUNTER = SystemCounter;
        ACTION = ACTIVATETASK {
            TASK = pendule;
        };  
        AUTOSTART = TRUE {
            ALARMTIME = 1;
            CYCLETIME = 4;
            APPMODE =std;
        };
    };

    COUNTER SystemCounter2 {
      SOURCE = it_timer1;
      MAXALLOWEDVALUE = 2000;
      TICKSPERBASE = 1;
      MINCYCLE = 1; 
    };

    ALARM affichage_alarm {
        COUNTER = SystemCounter2;
        ACTION = ACTIVATETASK {
            TASK = affichage;
        };
        AUTOSTART = TRUE {
            ALARMTIME = 1;
            CYCLETIME = 500;
            APPMODE =std;
        };
    };

    COUNTER SystemCounter3 {
      SOURCE = it_timer1;
      MAXALLOWEDVALUE = 2000;
      TICKSPERBASE = 1;
      MINCYCLE = 1; 
    };

    ALARM obstacle_alarm {
        COUNTER = SystemCounter3;
        ACTION = ACTIVATETASK {
            TASK = obstacle;
        };
        AUTOSTART = TRUE {
            ALARMTIME = 1;
            CYCLETIME = 40;
            APPMODE =std;
        };
    };

   ISR isr_button_start {
       CATEGORY = 2;
		PRIORITY = 1;
		SOURCE = button_start;
   };

   ISR isr_button_stop {
       CATEGORY = 2;
		PRIORITY = 1;
		SOURCE = button_stop;
   };

   ISR isr_button_left {
       CATEGORY = 2;
		PRIORITY = 1;
		SOURCE = button_left;
   };

   ISR isr_button_right {
       CATEGORY = 2;
		PRIORITY = 1;
		SOURCE = button_right;
   };
};

/* End of file nxt_simple.oil */

